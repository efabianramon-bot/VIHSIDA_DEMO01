    {
      "name": "3. Expediente clinico (RF-CORE-02)",
      "description": "Solo rol Medico. El expediente se identifica por codigo serologico, no por la identidad del paciente.",
      "item": [
        {
          "name": "Medico consulta el expediente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}"
          }
        },
        {
          "name": "Expediente inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', function () { pm.expect(pm.response.code).to.be.oneOf([404]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/NO-EXISTE"
          }
        },
        {
          "name": "Abrir expediente (201 si el paciente no tiene, 409 si ya tiene)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 o 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoResponsableId\": {{medicoId}}\n}"
            }
          }
        },
        {
          "name": "Actualizar medico responsable y estado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicoResponsableId\": {{medicoId}},\n  \"estado\": \"Activo\"\n}"
            }
          }
        },
        {
          "name": "Actualizar con estado invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', function () { pm.expect(pm.response.code).to.be.oneOf([409]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicoResponsableId\": {{medicoId}},\n  \"estado\": \"Cerrado\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Consulta y receta TARV (RF-CORE-03)",
      "description": "La consulta y sus recetas se guardan en una sola transaccion. La primera peticion guarda recetaId para la carpeta 5.",
      "item": [
        {
          "name": "Registrar consulta con receta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('recetaId', pm.response.json().recetas[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}/consultas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosticoDetalle\": \"Control trimestral\",\n  \"notasClinicas\": \"Continuar esquema\",\n  \"cargaViral\": 40,\n  \"conteoCd4\": 710,\n  \"recetas\": [\n    { \"medicamentoId\": {{medicamentoId}}, \"esquemaTarv\": \"TLD 1 tableta diaria\", \"cantidadPrescrita\": 30 }\n  ]\n}"
            }
          }
        },
