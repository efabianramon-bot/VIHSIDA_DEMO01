            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}/consultas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosticoDetalle\": \"x\",\n  \"recetas\": [ { \"medicamentoId\": 999999, \"cantidadPrescrita\": 5 } ]\n}"
            }
          }
        },
        {
          "name": "Consulta vacia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', function () { pm.expect(pm.response.code).to.be.oneOf([409]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}/consultas",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Historial del expediente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('Trae al menos una consulta', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioMedico}}"
              },
              {
                "key": "X-Roles",
                "value": "Medico"
              }
            ],
            "url": "{{baseUrl}}/api/clinica/expediente/{{codigo}}/historial"
          }
        }
      ]
