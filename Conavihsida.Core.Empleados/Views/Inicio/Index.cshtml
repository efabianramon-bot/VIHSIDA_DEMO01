@model List<OpcionMenu>
@{
    ViewBag.Title = "Inicio";
    var sesion = EmpleadoPrincipal.SesionActual(Context);
}

<h1 class="titulo-pagina">Hola, @sesion.NombreCompleto</h1>

@if (Model.Count == 0)
{
    <div class="aviso aviso-info">
        Tu rol (@string.Join(", ", sesion.Roles.Select(NombresRol.Mostrar))) no tiene pantallas en esta aplicación.
        @if (sesion.Roles.Contains(NombresRol.Cajero))
        {
            <text>El trabajo de ventanilla se hace en la aplicación de Caja.</text>
        }
    </div>
}
else
{
    <p class="subtitulo">Estos son los portales disponibles para tu rol.</p>

    <div class="tarjetas">
        @foreach (var opcion in Model)
        {
            if (opcion.Disponible)
            {
                <a class="tarjeta" href="@Url.Action("Index", opcion.Controlador)">
                    <h2>@opcion.Titulo</h2>
                    <p>@opcion.Descripcion</p>
                    <span class="tarjeta-accion">Entrar</span>
                </a>
            }
            else
            {
                <div class="tarjeta tarjeta-inactiva">
                    <h2>@opcion.Titulo</h2>
                    <p>@opcion.Descripcion</p>
                    <span class="etiqueta">En construcción</span>
                </div>
            }
        }
    </div>
}
