@model DashboardViewModel
@{
    ViewBag.Title = "Dashboard Ejecutivo";
}

<div class="encabezado-pagina">
    <div>
        <h1 class="titulo-pagina">Dashboard Ejecutivo</h1>
        <p class="subtitulo">Indicadores de los últimos @Model.Dias días. Solo totales: sin datos de pacientes.</p>
    </div>
    <nav class="periodos" aria-label="Periodo">
        @foreach (var periodo in DashboardViewModel.Periodos)
        {
            <a class="periodo @(periodo == Model.Dias ? "activo" : "")"
               href="@Url.Action("Index", new { dias = periodo })"
               @(periodo == Model.Dias ? "aria-current=page" : "")>@periodo días</a>
        }
    </nav>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="aviso aviso-error" role="alert">@Model.Error</div>
}

@if (Model.Datos != null)
{
    var pacientes = Model.Datos.Pacientes;
    var adherencia = Model.Datos.Adherencia;
    var inventario = Model.Datos.Inventario;
    var subsidios = Model.Datos.Subsidios;
    int recetasContadas = adherencia.RecetasEmitidas - adherencia.RecetasCanceladas;

    <div class="tablero">

        <section class="panel indicador-panel">
            <h2>Pacientes activos</h2>
            <div class="cifra-principal">
                <span class="cifra">@pacientes.Activos</span>
                <span class="cifra-nombre">expedientes activos de @pacientes.Total</span>
            </div>

            @if (pacientes.Total > 0)
            {
                <div class="barra-apilada" role="img"
                     aria-label="Activos @pacientes.Activos, inactivos @pacientes.Inactivos, transferidos @pacientes.Transferidos">
                    <span class="tramo tramo-exito" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(pacientes.Activos, pacientes.Total))%"></span>
                    <span class="tramo tramo-neutro" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(pacientes.Inactivos, pacientes.Total))%"></span>
                    <span class="tramo tramo-info" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(pacientes.Transferidos, pacientes.Total))%"></span>
                </div>
            }
            <ul class="leyenda">
                <li><span class="punto punto-exito"></span>Activos <strong>@pacientes.Activos</strong></li>
                <li><span class="punto punto-neutro"></span>Inactivos <strong>@pacientes.Inactivos</strong></li>
                <li><span class="punto punto-info"></span>Transferidos <strong>@pacientes.Transferidos</strong></li>
            </ul>
            <p class="nota-indicador">@pacientes.NuevosEnPeriodo expedientes abiertos en el periodo.</p>
        </section>

        <section class="panel indicador-panel">
            <h2>Adherencia al tratamiento</h2>
            <div class="con-anillo">
                @Html.Partial("_Anillo", new AnilloViewModel { Porcentaje = adherencia.PorcentajeAdherencia, Rotulo = "Recetas retiradas" })
                <div class="barras">
                    @foreach (var fila in new[]
                    {
                        new { Nombre = "Retiradas", Valor = adherencia.RecetasDispensadas, Clase = "exito" },
                        new { Nombre = "Sin retirar", Valor = adherencia.RecetasPendientes, Clase = "alerta" },
                        new { Nombre = "Vencidas", Valor = adherencia.RecetasVencidas, Clase = "error" }
                    })
                    {
                        <div class="barra-fila">
                            <span class="barra-nombre">@fila.Nombre</span>
                            <span class="barra-pista"><span class="tramo tramo-@fila.Clase" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(fila.Valor, recetasContadas))%"></span></span>
                            <span class="barra-valor">@fila.Valor</span>
                        </div>
                    }
                </div>
            </div>
            <p class="nota-indicador">
                @adherencia.RecetasEmitidas recetas emitidas (@adherencia.RecetasCanceladas canceladas).
                @adherencia.PacientesConRetiro de @adherencia.PacientesConReceta pacientes con receta retiraron al menos una.
            </p>
        </section>

        <section class="panel indicador-panel">
            <h2>Inventario crítico</h2>
            <div class="cifras-fila">
                <div class="cifra-chica @(inventario.LotesVencidosConExistencia > 0 ? "cifra-error" : "")">
                    <span class="cifra">@inventario.LotesVencidosConExistencia</span>
                    <span class="cifra-nombre">vencidos con existencia</span>
                </div>
                <div class="cifra-chica @(inventario.LotesPorVencer > 0 ? "cifra-alerta" : "")">
                    <span class="cifra">@inventario.LotesPorVencer</span>
                    <span class="cifra-nombre">vencen en @inventario.DiasAviso días</span>
                </div>
                <div class="cifra-chica @(inventario.LotesBajoMinimo > 0 ? "cifra-alerta" : "")">
                    <span class="cifra">@inventario.LotesBajoMinimo</span>
                    <span class="cifra-nombre">en su mínimo o por debajo</span>
                </div>
            </div>

            @if (inventario.Lotes != null && inventario.Lotes.Count > 0)
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-compacta">
                        <thead>
                            <tr><th>Medicamento</th><th>Lote</th><th>Caduca</th><th class="numero">Existencia</th><th>Alerta</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var lote in inventario.Lotes)
                            {
                                <tr>
                                    <td>@lote.MedicamentoNombre</td>
                                    <td class="codigo">@lote.NumeroLote</td>
                                    <td>@lote.FechaCaducidad.ToString("dd/MM/yyyy")</td>
                                    <td class="numero">@lote.ExistenciaActual / @lote.ExistenciaMinima mín.</td>
                                    <td>
                                        @if (lote.Vencido)
                                        {
                                            <span class="estado estado-alerta-error">Vencido</span>
                                        }
                                        else if (lote.ExistenciaActual == 0)
                                        {
                                            <span class="estado estado-alerta">Agotado</span>
                                        }
                                        else if (lote.BajoMinimo)
                                        {
                                            <span class="estado estado-alerta">Bajo mínimo</span>
                                        }
                                        else
                                        {
                                            <span class="estado estado-alerta">Vence en @lote.DiasParaCaducar días</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="nota-indicador">Ningún lote requiere atención.</p>
            }
        </section>

        <section class="panel indicador-panel">
            <h2>Ejecución de subsidios</h2>
            @* El anillo muestra cuanto de los fondos se ha usado; si Caja
               aun no ha sincronizado fondos, las facturas subsidiadas. *@
            <div class="con-anillo">
                @if (subsidios.HayFondos)
                {
                    @Html.Partial("_Anillo", new AnilloViewModel { Porcentaje = subsidios.PorcentajeEjecucionFondos, Rotulo = "Fondos utilizados" })
                }
                else
                {
                    @Html.Partial("_Anillo", new AnilloViewModel { Porcentaje = subsidios.PorcentajeEjecucion, Rotulo = "Facturas descargadas" })
                }
                <div class="barras">
                    <div class="barra-fila">
                        <span class="barra-nombre">Entregas ARV</span>
                        <span class="barra-pista"><span class="tramo tramo-info" style="width: @(subsidios.EntregasArv > 0 ? "100" : "0")%"></span></span>
                        <span class="barra-valor">@subsidios.EntregasArv</span>
                    </div>
                    <div class="barra-fila">
                        <span class="barra-nombre">Con descargo</span>
                        <span class="barra-pista"><span class="tramo tramo-exito" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(subsidios.EntregasArvConDescargo, subsidios.EntregasArv))%"></span></span>
                        <span class="barra-valor">@subsidios.EntregasArvConDescargo</span>
                    </div>
                    <div class="barra-fila">
                        <span class="barra-nombre">Sin descargo</span>
                        <span class="barra-pista"><span class="tramo tramo-alerta" style="width: @DashboardViewModel.Css(DashboardViewModel.Porcentaje(subsidios.EntregasArv - subsidios.EntregasArvConDescargo, subsidios.EntregasArv))%"></span></span>
                        <span class="barra-valor">@(subsidios.EntregasArv - subsidios.EntregasArvConDescargo)</span>
                    </div>
                </div>
            </div>

            <div class="cifras-fila">
                <div class="cifra-chica">
                    <span class="cifra">@subsidios.EntregasSubsidiadasCaja</span>
                    <span class="cifra-nombre">entregas subsidiadas en Caja</span>
                </div>
                <div class="cifra-chica">
                    <span class="cifra">@subsidios.CobrosCaja</span>
                    <span class="cifra-nombre">cobros en Caja (RD$ @subsidios.MontoCobradoCaja.ToString("#,0.00"))</span>
                </div>
                <div class="cifra-chica @(subsidios.TransaccionesAnuladasCaja > 0 ? "cifra-alerta" : "")">
                    <span class="cifra">@subsidios.TransaccionesAnuladasCaja</span>
                    <span class="cifra-nombre">transacciones anuladas</span>
                </div>
            </div>

            @if (subsidios.HayFondos)
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-compacta">
                        <thead>
                            <tr><th>Fondo o convenio</th><th>Fuente</th><th class="numero">Asignado (RD$)</th><th class="numero">Utilizado (RD$)</th><th class="numero">%</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var fondo in subsidios.Fondos)
                            {
                                <tr>
                                    <td>@fondo.Nombre</td>
                                    <td>@fondo.Fuente</td>
                                    <td class="numero">@fondo.MontoAsignado.ToString("#,0.00")</td>
                                    <td class="numero">@fondo.MontoUtilizado.ToString("#,0.00")</td>
                                    <td class="numero">@(fondo.PorcentajeUtilizado == null ? "—" : fondo.PorcentajeUtilizado.Value.ToString("0.#"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="nota-indicador">Caja todavía no ha sincronizado fondos ni convenios.</p>
            }

            <div class="acciones">
                <a class="boton boton-secundario" href="@Url.Action("CuadresCaja", new { dias = Model.Dias })">Ver cuadres de caja</a>
            </div>

            <p class="nota-indicador">
                @subsidios.UnidadesArvEntregadas.ToString("#,0") unidades de antirretrovirales entregadas en Farmacia, todas al 100 % de subsidio.
                @subsidios.FacturasDescargadas de @subsidios.FacturasSubsidiadas facturas subsidiadas del Portal Web descargadas.
                Los fondos muestran el acumulado que reporta Caja, no solo el periodo.
            </p>
        </section>

    </div>
}
