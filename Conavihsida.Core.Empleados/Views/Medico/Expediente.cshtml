@model ExpedienteViewModel
@{
    ViewBag.Title = "Expediente " + Model.Expediente.CodigoSerologico;
    var expediente = Model.Expediente;
}

<p class="migas"><a href="@Url.Action("Index")">Portal Médico</a> / Expediente</p>

<div class="encabezado-expediente">
    <div>
        <h1 class="titulo-pagina codigo">@expediente.CodigoSerologico</h1>
        <p class="dato-suave">
            Abierto el @expediente.FechaApertura.ToString("dd/MM/yyyy") ·
            Médico responsable: @(Model.MedicoResponsable ?? "sin asignar")
        </p>
    </div>
    <span class="estado estado-@expediente.Estado.ToLowerInvariant()">@expediente.Estado</span>
</div>

@if (!string.IsNullOrEmpty(Model.Exito))
{
    <div class="aviso aviso-exito" role="status">@Model.Exito</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="aviso aviso-error" role="alert">@Model.Error</div>
}

@if (Model.Paciente != null)
{
    <section class="panel">
        <h2>Paciente</h2>
        <dl class="datos">
            <div><dt>Nombre</dt><dd>@Model.Paciente.NombreCompleto</dd></div>
            <div><dt>Cédula</dt><dd>@Model.Paciente.Cedula</dd></div>
            <div>
                <dt>Nacimiento</dt>
                <dd>@(Model.Paciente.FechaNacimiento == null ? "Sin registrar" : Model.Paciente.FechaNacimiento.Value.ToString("dd/MM/yyyy"))</dd>
            </div>
        </dl>
    </section>
}

<h2 class="titulo-seccion">Historial clínico</h2>
@if (Model.Consultas.Count == 0)
{
    <p class="dato-suave">Este expediente todavía no tiene consultas.</p>
}
else
{
    foreach (var consulta in Model.Consultas)
    {
        <article class="panel consulta">
            <header class="consulta-encabezado">
                <h3>Consulta del @consulta.FechaConsulta.ToString("dd/MM/yyyy HH:mm")</h3>
                <div class="indicadores">
                    <span class="indicador">
                        <span class="indicador-nombre">Carga viral</span>
                        <span class="indicador-valor">@(consulta.CargaViral == null ? "—" : consulta.CargaViral.Value.ToString("#,0.##") + " copias/mL")</span>
                    </span>
                    <span class="indicador">
                        <span class="indicador-nombre">CD4</span>
                        <span class="indicador-valor">@(consulta.ConteoCd4 == null ? "—" : consulta.ConteoCd4.Value.ToString("#,0") + " cél/µL")</span>
                    </span>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(consulta.DiagnosticoDetalle))
            {
                <p><strong>Diagnóstico y evolución.</strong> @consulta.DiagnosticoDetalle</p>
            }
            @if (!string.IsNullOrEmpty(consulta.NotasClinicas))
            {
                <p><strong>Notas.</strong> @consulta.NotasClinicas</p>
            }

            @if (consulta.Recetas != null && consulta.Recetas.Count > 0)
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-compacta">
                        <thead>
                            <tr>
                                <th>Receta</th>
                                <th>Medicamento</th>
                                <th>Esquema TARV</th>
                                <th class="numero">Cantidad</th>
                                <th>Estado</th>
                                <th><span class="solo-lectores">Imprimir</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var receta in consulta.Recetas)
                            {
                                <tr>
                                    <td>n.º @receta.Id</td>
                                    <td>@Model.NombreMedicamento(receta.MedicamentoId)</td>
                                    <td>@(string.IsNullOrEmpty(receta.EsquemaTarv) ? "—" : receta.EsquemaTarv)</td>
                                    <td class="numero">@receta.CantidadPrescrita</td>
                                    <td><span class="estado estado-@receta.Estado.ToLowerInvariant()">@receta.Estado</span></td>
                                    <td class="celda-accion">
                                        <a href="@Url.Action("Receta", new { codigo = expediente.CodigoSerologico, id = receta.Id })">Imprimir receta</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }
}

<h2 class="titulo-seccion" id="resultados">Resultados de laboratorio</h2>
<p class="dato-suave">
    El paciente ve en su portal la prueba, la fecha, el estado y la nota. El valor del resultado solo se ve aquí.
</p>
@if (Model.Resultados.Count == 0)
{
    <p class="dato-suave">Este expediente todavía no tiene pruebas solicitadas.</p>
}
else
{
    foreach (var resultado in Model.Resultados)
    {
        <article class="panel resultado">
            <header class="consulta-encabezado">
                <h3>@resultado.Prueba</h3>
                <span class="estado estado-@resultado.Estado.ToLowerInvariant()">@resultado.Estado</span>
            </header>
            <p class="dato-suave">
                Solicitada el @resultado.FechaSolicitud.ToString("dd/MM/yyyy")@(resultado.FechaResultado == null ? "" : " · Publicada el " + resultado.FechaResultado.Value.ToString("dd/MM/yyyy HH:mm"))
            </p>

            @if (resultado.EstaListo)
            {
                <p><strong>Valor.</strong> @resultado.ValorResultado</p>
                <p><strong>Nota para el paciente.</strong> @(string.IsNullOrEmpty(resultado.NotaPaciente) ? "—" : resultado.NotaPaciente)</p>
            }
            else
            {
                using (Html.BeginForm("PublicarResultado", "Medico", FormMethod.Post, new { @class = "formulario-resultado" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" value="@expediente.CodigoSerologico" />
                    <input type="hidden" name="resultadoId" value="@resultado.Id" />
                    <div class="fila-campos">
                        <div class="campo">
                            <label for="resultado_@(resultado.Id)_valor">Valor del resultado</label>
                            <input type="text" id="resultado_@(resultado.Id)_valor" name="valorResultado" required
                                   placeholder="Ej.: 35 copias/mL" />
                        </div>
                        <div class="campo">
                            <label for="resultado_@(resultado.Id)_nota">Nota para el paciente (sin valores clínicos)</label>
                            <input type="text" id="resultado_@(resultado.Id)_nota" name="notaPaciente" maxlength="200"
                                   value="@resultado.NotaPaciente" />
                        </div>
                    </div>
                    <div class="acciones">
                        <button type="submit" class="boton boton-secundario">Publicar resultado</button>
                    </div>
                }
            }
        </article>
    }
}

@if (Model.AdmiteConsultas)
{
    using (Html.BeginForm("SolicitarPrueba", "Medico", FormMethod.Post, new { @class = "panel formulario-clinico" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="codigo" value="@expediente.CodigoSerologico" />
        <h3>Solicitar una prueba</h3>
        <div class="fila-campos">
            <div class="campo">
                <label for="prueba">Prueba</label>
                <input type="text" id="prueba" name="prueba" maxlength="100" required placeholder="Ej.: Carga viral" />
            </div>
            <div class="campo">
                <label for="notaPaciente">Nota para el paciente (opcional, sin valores clínicos)</label>
                <input type="text" id="notaPaciente" name="notaPaciente" maxlength="200"
                       placeholder="Ej.: Presentarse en ayunas" />
            </div>
        </div>
        <div class="acciones">
            <button type="submit" class="boton boton-primario">Solicitar prueba</button>
        </div>
    }
}

<h2 class="titulo-seccion">Registrar consulta</h2>
@if (!Model.AdmiteConsultas)
{
    <div class="aviso aviso-alerta">El expediente está @expediente.Estado.ToLowerInvariant(): no admite nuevas consultas.</div>
}
else
{
    using (Html.BeginForm("RegistrarConsulta", "Medico", FormMethod.Post, new { @class = "panel formulario-clinico" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="codigo" value="@expediente.CodigoSerologico" />

        <div class="campo">
            <label for="consulta_DiagnosticoDetalle">Diagnóstico y evolución</label>
            <textarea id="consulta_DiagnosticoDetalle" name="consulta.DiagnosticoDetalle" rows="3">@Model.NuevaConsulta.DiagnosticoDetalle</textarea>
        </div>

        <div class="campo">
            <label for="consulta_NotasClinicas">Notas clínicas</label>
            <textarea id="consulta_NotasClinicas" name="consulta.NotasClinicas" rows="2">@Model.NuevaConsulta.NotasClinicas</textarea>
        </div>

        <div class="fila-campos">
            <div class="campo">
                <label for="consulta_CargaViral">Carga viral (copias/mL)</label>
                <input type="number" id="consulta_CargaViral" name="consulta.CargaViral" min="0" step="0.01"
                       value="@(Model.NuevaConsulta.CargaViral == null ? "" : Model.NuevaConsulta.CargaViral.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
            </div>
            <div class="campo">
                <label for="consulta_ConteoCd4">Conteo de CD4 (cél/µL)</label>
                <input type="number" id="consulta_ConteoCd4" name="consulta.ConteoCd4" min="0" step="1"
                       value="@Model.NuevaConsulta.ConteoCd4" />
            </div>
        </div>

        <fieldset class="recetas">
            <legend>Recetas TARV (opcional)</legend>
            <p class="dato-suave">Deja sin medicamento las filas que no uses. La consulta y sus recetas se guardan juntas.</p>
            @for (int i = 0; i < Model.NuevaConsulta.Recetas.Count; i++)
            {
                var receta = Model.NuevaConsulta.Recetas[i];
                <div class="fila-receta">
                    <div class="campo campo-ancho">
                        <label for="receta_@(i)_medicamento">Medicamento @(i + 1)</label>
                        <select id="receta_@(i)_medicamento" name="consulta.Recetas[@i].MedicamentoId">
                            <option value="">— Ninguno —</option>
                            @foreach (var medicamento in Model.Medicamentos)
                            {
                                <option value="@medicamento.Id" @(receta.MedicamentoId == medicamento.Id ? "selected" : "")>@medicamento.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="campo campo-ancho">
                        <label for="receta_@(i)_esquema">Esquema</label>
                        <input type="text" id="receta_@(i)_esquema" name="consulta.Recetas[@i].EsquemaTarv"
                               maxlength="150" value="@receta.EsquemaTarv" placeholder="Ej.: 1 tableta diaria" />
                    </div>
                    <div class="campo campo-corto">
                        <label for="receta_@(i)_cantidad">Cantidad</label>
                        <input type="number" id="receta_@(i)_cantidad" name="consulta.Recetas[@i].CantidadPrescrita"
                               min="1" step="1" value="@receta.CantidadPrescrita" />
                    </div>
                </div>
            }
        </fieldset>

        <div class="acciones">
            <button type="submit" class="boton boton-primario">Guardar consulta</button>
        </div>
    }
}
