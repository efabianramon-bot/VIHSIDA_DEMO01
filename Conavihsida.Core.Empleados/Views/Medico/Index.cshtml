@model MedicoInicioViewModel
@{
    ViewBag.Title = "Portal Médico";
}

<h1 class="titulo-pagina">Portal Médico</h1>
<p class="subtitulo">Busca al paciente por su cédula o abre un expediente por su código serológico.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="aviso aviso-error" role="alert">@Model.Error</div>
}

@using (Html.BeginForm("Buscar", "Medico", FormMethod.Get, new { @class = "buscador" }))
{
    <label for="q" class="solo-lectores">Cédula o código de expediente</label>
    <input type="text" id="q" name="q" value="@Model.Busqueda" maxlength="20" autofocus
           placeholder="Cédula (000-0000000-0) o código (EXP-…)" />
    <button type="submit" class="boton boton-primario">Buscar</button>
}

@if (!string.IsNullOrEmpty(Model.Exito))
{
    <div class="aviso aviso-exito" role="status">@Model.Exito</div>
}

@if (Model.NuevoPaciente != null)
{
    var nuevo = Model.NuevoPaciente;
    using (Html.BeginForm("RegistrarPaciente", "Medico", FormMethod.Post, new { @class = "panel formulario-estrecho" }))
    {
        @Html.AntiForgeryToken()
        <h2>Registrar paciente</h2>
        <p class="dato-suave">
            No hay ningún paciente registrado con esa cédula. Si es alguien que llega por primera vez,
            regístralo aquí para poder abrirle el expediente.
        </p>

        <div class="fila-campos">
            <div class="campo">
                <label for="paciente_Cedula">Cédula</label>
                <input type="text" id="paciente_Cedula" name="paciente.Cedula" maxlength="13" required
                       value="@nuevo.Cedula" placeholder="000-0000000-0" />
            </div>
            <div class="campo">
                <label for="paciente_FechaNacimiento">Fecha de nacimiento (opcional)</label>
                <input type="date" id="paciente_FechaNacimiento" name="paciente.FechaNacimiento"
                       value="@(nuevo.FechaNacimiento == null ? "" : nuevo.FechaNacimiento.Value.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="campo">
            <label for="paciente_NombreCompleto">Nombre completo, como aparece en la cédula</label>
            <input type="text" id="paciente_NombreCompleto" name="paciente.NombreCompleto" maxlength="150" required
                   value="@nuevo.NombreCompleto" />
        </div>

        <div class="campo">
            <label for="paciente_Correo">Correo electrónico (opcional)</label>
            <input type="email" id="paciente_Correo" name="paciente.Correo" maxlength="150" value="@nuevo.Correo" />
            <p class="dato-suave">
                Anótalo si el paciente quiere usar el Portal Web: al crear su cuenta deberá usar esta misma cédula y este mismo correo.
            </p>
        </div>

        <div class="acciones">
            <button type="submit" class="boton boton-primario">Registrar paciente</button>
            <a class="boton boton-neutro" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
}

@if (Model.PacienteSinExpediente != null)
{
    var paciente = Model.PacienteSinExpediente;
    <section class="panel">
        <h2>@paciente.NombreCompleto</h2>
        <p class="dato-suave">
            Cédula @paciente.Cedula
            @if (paciente.FechaNacimiento != null)
            {
                <text>· Nacimiento @paciente.FechaNacimiento.Value.ToString("dd/MM/yyyy")</text>
            }
        </p>
        <p>Este paciente todavía no tiene expediente clínico.</p>
        @using (Html.BeginForm("AbrirExpediente", "Medico", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="pacienteId" value="@paciente.PacienteId" />
            <button type="submit" class="boton boton-primario">Abrir expediente</button>
        }
    </section>
}

<h2 class="titulo-seccion">Expedientes</h2>
@if (Model.Expedientes.Count == 0)
{
    <p class="dato-suave">Todavía no hay expedientes abiertos.</p>
}
else
{
    <div class="tabla-contenedor">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Código serológico</th>
                    <th>Estado</th>
                    <th>Apertura</th>
                    <th><span class="solo-lectores">Acción</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expediente in Model.Expedientes)
                {
                    <tr>
                        <td class="codigo">@expediente.CodigoSerologico</td>
                        <td><span class="estado estado-@expediente.Estado.ToLowerInvariant()">@expediente.Estado</span></td>
                        <td>@expediente.FechaApertura.ToString("dd/MM/yyyy")</td>
                        <td class="celda-accion">
                            <a href="@Url.Action("Expediente", new { codigo = expediente.CodigoSerologico })">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
