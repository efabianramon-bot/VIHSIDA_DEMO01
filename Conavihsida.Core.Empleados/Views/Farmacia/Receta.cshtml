@model RecetaViewModel
@{
    ViewBag.Title = "Receta n.º " + Model.Receta.Id;
    var receta = Model.Receta;
}

<p class="migas"><a href="@Url.Action("Index")">Farmacia</a> / Receta</p>

<div class="encabezado-expediente">
    <div>
        <h1 class="titulo-pagina">Receta n.º @receta.Id</h1>
        <p class="dato-suave">
            Emitida el @receta.FechaEmision.ToString("dd/MM/yyyy HH:mm") ·
            @(receta.Estado == "Vencida" ? "Venció" : "Vence") el @receta.FechaVencimiento.ToString("dd/MM/yyyy")
        </p>
    </div>
    <span class="estado estado-@receta.Estado.ToLowerInvariant()">@receta.Estado</span>
</div>

@if (!string.IsNullOrEmpty(Model.Exito))
{
    <div class="aviso aviso-exito" role="status">@Model.Exito</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="aviso aviso-error" role="alert">@Model.Error</div>
}

<section class="panel">
    <h2>Qué entregar</h2>
    <dl class="datos">
        <div><dt>Medicamento</dt><dd>@Model.MedicamentoNombre</dd></div>
        <div><dt>Cantidad</dt><dd>@receta.CantidadPrescrita</dd></div>
        <div><dt>Esquema</dt><dd>@(string.IsNullOrEmpty(receta.EsquemaTarv) ? "—" : receta.EsquemaTarv)</dd></div>
        <div><dt>Expediente</dt><dd class="codigo">@receta.CodigoSerologico</dd></div>
        <div>
            <dt>Descargo en Caja</dt>
            <dd>
                @if (receta.DescargadaEnCaja)
                {
                    <span class="estado estado-activa">Descargada</span>
                    <text> el @receta.FechaDescargo.Value.ToString("dd/MM/yyyy HH:mm")</text>
                }
                else if (Model.EstaActiva)
                {
                    <span class="estado estado-pendiente">Pendiente de descargo</span>
                }
                else
                {
                    <text>Sin descargo registrado</text>
                }
            </dd>
        </div>
    </dl>
</section>

@if (Model.EstaActiva)
{
    <section class="panel">
        <h2>Existencia disponible</h2>
        @if (Model.LotesDisponibles.Count == 0)
        {
            <p>No hay lotes vigentes con existencia de este medicamento.</p>
        }
        else
        {
            <p class="dato-suave">
                @Model.ExistenciaDisponible unidades en lotes vigentes. El despacho toma primero del lote que caduca antes.
            </p>
            <div class="tabla-contenedor">
                <table class="tabla tabla-compacta">
                    <thead>
                        <tr><th>Lote</th><th>Caduca</th><th class="numero">Existencia</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var lote in Model.LotesDisponibles)
                        {
                            <tr>
                                <td class="codigo">@lote.NumeroLote</td>
                                <td>@lote.FechaCaducidad.ToString("dd/MM/yyyy")</td>
                                <td class="numero">@lote.ExistenciaActual</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!Model.AlcanzaLaExistencia)
        {
            <div class="aviso aviso-alerta aviso-en-panel">
                La existencia no alcanza para despachar la receta completa (faltan @(receta.CantidadPrescrita - Model.ExistenciaDisponible)).
                Registra un lote antes de despachar.
            </div>
        }
        else
        {
            if (!receta.DescargadaEnCaja)
            {
                <div class="aviso aviso-alerta aviso-en-panel">
                    Caja todavía no ha registrado el descargo de esta receta. Puede que su terminal esté sin conexión.
                    Puedes despachar, pero quedará anotado en la bitácora como despacho sin descargo.
                </div>
            }
            using (Html.BeginForm("Despachar", "Farmacia", new { id = receta.Id }, FormMethod.Post, new { @class = "acciones acciones-en-panel" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="boton boton-primario">
                    @(receta.DescargadaEnCaja ? "Despachar" : "Despachar sin descargo:") @receta.CantidadPrescrita unidades
                </button>
            }
        }
    </section>
}
else
{
    <div class="aviso aviso-info">Esta receta está @receta.Estado.ToLowerInvariant(): ya no se puede despachar.</div>
    if (receta.Estado == "Dispensada")
    {
        <div class="acciones">
            <a class="boton boton-primario" href="@Url.Action("Comprobante", new { id = receta.Id })">Comprobante de despacho</a>
        </div>
    }
}
