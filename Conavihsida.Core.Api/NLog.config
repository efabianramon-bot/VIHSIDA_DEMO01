<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <targets>
    <!-- Un archivo por dia, dentro de App_Data/logs. Esa carpeta NO se
         sirve por HTTP, asi que es un lugar seguro para logs. -->
    <target xsi:type="File" name="archivoLog"
            fileName="${basedir}/App_Data/logs/core-api-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="archivoLog" />
  </rules>
</nlog>
