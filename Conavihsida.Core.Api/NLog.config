<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <targets>
    <!-- Un archivo por dia y por tipo, dentro de App_Data/logs. Esa
         carpeta NO se sirve por HTTP, asi que es un lugar seguro para logs. -->

    <!-- Log TECNICO: todas las peticiones, con codigo y duracion. -->
    <target xsi:type="File" name="archivoLog"
            fileName="${basedir}/App_Data/logs/core-api-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${message} ${exception:format=tostring}" />

    <!-- Log de TRANSACCIONES: operaciones de negocio, completadas o rechazadas. -->
    <target xsi:type="File" name="archivoTransacciones"
            fileName="${basedir}/App_Data/logs/transacciones-${shortdate}.log"
            layout="${longdate} | ${message}" />

    <!-- Log de BASE DE DATOS: errores de SQL, conexion, consultas lentas, COMMIT y ROLLBACK. -->
    <target xsi:type="File" name="archivoBaseDatos"
            fileName="${basedir}/App_Data/logs/base-datos-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${message}" />
  </targets>

  <rules>
    <!-- final="true": lo de estos dos loggers no se repite en el log tecnico. -->
    <logger name="Transacciones" minlevel="Info" writeTo="archivoTransacciones" final="true" />
    <logger name="BaseDatos" minlevel="Info" writeTo="archivoBaseDatos" final="true" />
    <logger name="*" minlevel="Info" writeTo="archivoLog" />
  </rules>
</nlog>
